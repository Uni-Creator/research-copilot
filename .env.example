# LLM provider (Planner + later agents)
ANTHROPIC_API_KEY=your-key-here
COPILOT_MODEL_PROVIDER=anthropic
COPILOT_PLANNER_MODEL=claude-haiku-5-5

# Optional: higher Semantic Scholar rate limits (https://www.semanticscholar.org/product/api)
S2_API_KEY=

# arXiv / S2 ask for a contact in the User-Agent
COPILOT_USER_AGENT=research-copilot/0.1 (mailto:you@example.com)

# Retrieval knobs
COPILOT_MAX_PAPERS=20
COPILOT_MAX_RESULTS_PER_QUERY=10

# Models: cheap for extraction, stronger for writing and judging
COPILOT_READER_MODEL=claude-haiku-5-5
COPILOT_WRITER_MODEL=claude-sonnet-5-5
COPILOT_CRITIC_MODEL=claude-sonnet-5-5

# "bge" (sentence-transformers) or "hash" (offline, no download)
COPILOT_EMBEDDER=bge
COPILOT_SUPPORT_THRESHOLD=0.85
COPILOT_MAX_ITERATIONS=2

# --- Deployment ---
# Gate the API (send as x-api-key) and the UI. Leave unset ONLY for local use:
# every run spends LLM tokens.
COPILOT_API_KEY=
COPILOT_UI_PASSWORD=
COPILOT_UI_MAX_PAPERS=20
